{
  "name": "cattle-drive",
  "description": "Rancher UI extension for migrating cluster objects between downstream clusters",
  "version": "0.1.0",
  "private": false,
  "rancher": {
    "annotations": {
      "catalog.cattle.io/kube-version": ">= 1.24.0-0",
      "catalog.cattle.io/rancher-version": ">= 2.10.0-0",
      "catalog.cattle.io/ui-extensions-version": ">= 3.0.0 < 4.0.0"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=dev ./node_modules/.bin/vue-cli-service serve",
    "build": "./node_modules/.bin/vue-cli-service build",
    "build-pkg": "sh -c 'set -e; mkdir -p pkg; rm -f pkg/cattle-drive; ln -s .. pkg/cattle-drive; trap \"rm -f pkg/cattle-drive\" EXIT; ./node_modules/@rancher/shell/scripts/build-pkg.sh cattle-drive tarball'",
    "publish-pkg": "./node_modules/@rancher/shell/scripts/extension/publish",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@rancher/shell": "3.0.8",
    "@vue/cli-plugin-babel": "5.0.8",
    "@vue/cli-plugin-typescript": "5.0.8"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
