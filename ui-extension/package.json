{
  "name": "cattle-drive",
  "description": "Rancher UI extension for migrating cluster objects between downstream clusters",
  "version": "0.1.0",
  "private": false,
  "rancher": {
    "annotations": {
      "catalog.cattle.io/kube-version": ">= 1.24.0-0",
      "catalog.cattle.io/rancher-version": ">= 2.10.0-0",
      "catalog.cattle.io/ui-extensions-version": ">= 3.0.0 < 4.0.0"
    }
  },
  "scripts": {
    "dev": "./node_modules/.bin/nuxt dev",
    "nuxt": "./node_modules/.bin/nuxt",
    "build-pkg": "shell-pkg build",
    "publish-pkg": "shell-pkg publish",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@rancher/shell": "~0.8.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/cli-plugin-typescript": "~5.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
